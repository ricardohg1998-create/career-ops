{
  "name": "career-ops",
  "version": "1.9.0",
  "description": "AI-powered job search pipeline built on Claude Code",
  "scripts": {
    "doctor": "node doctor.mjs",
    "app": "node app/server.mjs",
    "app:check": "node --check app/server.mjs && node --check app/smoke-test.mjs && node --check app/browser-smoke.mjs && node --check app/public/app.js && node --check app/public/modules/api.js && node --check app/public/modules/state.js && node --check app/lib/job-events.mjs && node --check app/lib/url-safety.mjs && node --check app/lib/markdown-table.mjs && node --check app/lib/script-runner.mjs && node --check app/lib/assisted-workers.mjs && node --check app/lib/cv-workspace.mjs && node --check app/lib/modules/index.mjs",
    "app:api-smoke": "node app/smoke-test.mjs",
    "app:browser-smoke": "node app/browser-smoke.mjs",
    "app:smoke": "node app/smoke-test.mjs && node app/browser-smoke.mjs",
    "test:quick": "node test-all.mjs --quick",
    "test": "node test-all.mjs",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "pdf": "node generate-pdf.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "scan": "node scan.mjs",
    "patterns": "node analyze-patterns.mjs",
    "eval": "node opencode-eval.mjs",
    "eval:fast": "node opencode-eval.mjs --preset fast",
    "eval:batch": "node opencode-eval.mjs --preset batch",
    "eval:draft": "node opencode-eval.mjs --preset draft",
    "eval:review": "node opencode-eval.mjs --preset review",
    "eval:long": "node opencode-eval.mjs --preset long",
    "eval:presets": "node opencode-eval.mjs --list-presets",
    "api:eval": "node opencode-eval.mjs",
    "gemini:eval": "node gemini-eval.mjs",
    "opencode:eval": "node opencode-eval.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "career-ops",
    "careerops",
    "automation"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.0.0",
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.1"
  }
}
